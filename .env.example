# Public origin of the site, without a trailing slash. Production: https://7labz.ai
NEXT_PUBLIC_SITE_URL=

# Inbox shown in the form's error message. Falls back to COMPANY.email (info@7labz.ai). [TBC]
NEXT_PUBLIC_CONTACT_EMAIL=

# --- "Talk to us" form (/api/apply). At least one destination must be set, or every send
# --- fails with a visible error instead of pretending it worked.

# CRM: URL that takes a JSON form answer (see README, "Contact form"). Server only.
CRM_FORM_URL=
# Optional shared secret sent as "Authorization: Bearer ..." to the CRM. Server only.
CRM_FORM_TOKEN=

# Email alert via Resend (resend.com). All three are needed for email. Server only.
RESEND_API_KEY=
# Comma-separated inboxes that get the alert, e.g. team@7labz.ai
LEADS_EMAIL_TO=
# Sender on a domain verified in Resend, e.g. "7labz site <site@7labz.ai>"
LEADS_EMAIL_FROM=
# Only for tests: where to send the email request instead of Resend's API.
RESEND_API_URL=
